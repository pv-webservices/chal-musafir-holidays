# ---------------------------------------------------------------------------
# Enquiry delivery
# ---------------------------------------------------------------------------
# Where /api/enquiry forwards every contact form and trip-planner submission.
# Point this at a CRM webhook, an email-relay endpoint (Formspree, Resend,
# Zapier, Make, n8n…) or your own backend.
#
# Until this is set, submissions are accepted in development and REJECTED in
# production with a message telling the visitor to call or WhatsApp instead —
# so no enquiry is ever silently lost.
TRAVEL_ENQUIRY_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <token>" when forwarding.
TRAVEL_ENQUIRY_WEBHOOK_TOKEN=
